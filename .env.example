# URL pública final del sitio (sin slash al final)
NEXT_PUBLIC_SITE_URL=https://example.com

# El WhatsApp e Instagram oficiales están centralizados en config/site.ts
# Reserva técnica: no se muestra públicamente aunque se configure
NEXT_PUBLIC_BUSINESS_EMAIL=
# Solo para entornos de prueba; no activar en el catálogo comercial
NEXT_PUBLIC_ENABLE_DEMO_CATALOG=false

# Sanity: development contiene exclusivamente productos demo.
# production queda reservado para productos reales. Ambos datasets son públicos.
# El Project ID y el dataset no son secretos.
NEXT_PUBLIC_SANITY_PROJECT_ID=0l7ykvj6
NEXT_PUBLIC_SANITY_DATASET=development
SANITY_API_VERSION=2025-02-19

# Único secreto de Sanity, exclusivamente del servidor (nunca NEXT_PUBLIC_).
# Token Editor para documentos, inventario, migraciones y assets.
SANITY_API_WRITE_TOKEN=
# Una o varias cuentas autorizadas, separadas por coma. Basta configurar una lista.
INVENTORY_ADMIN_EMAILS=
INVENTORY_ADMIN_USER_IDS=

# En Vercel, el panel permanece deshabilitado hasta integrar un proveedor de
# identidad confiable. No habilites la confianza en cabeceras enviadas por el navegador.
