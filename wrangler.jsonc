{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nela-joyeria",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "previews": {}
}
